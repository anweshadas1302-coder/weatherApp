<!DOCTYPE html>
<html>
<head>
    <title>Weather App</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <div class="container">

        <h1>🌤️ Weather App</h1>

        <p>Search the current weather of any city.</p>

        <form action="/weather" method="GET">

            <input
                type="text"
                name="city"
                placeholder="Enter city name"
                required
            >

            <button type="submit">
                Search
            </button>

        </form>

    </div>

</body>
</html>